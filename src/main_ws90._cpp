/**
 * ESP32-S3 + CC1101 Receiver with OLED display
 * Configured to receive packet: AA AA D391 04 41424344 3F4B
 *
 * Libraries:
 *   RadioLib        — jgromes/RadioLib
 *   Adafruit SSD1306 — adafruit/Adafruit SSD1306  (SSD1315 is pin-compatible)
 *
 * ── Wiring (ESP32-S3 DevKitC-1 → CC1101) ────────────────────────────────────
 *
 *   CC1101 Pin   ESP32-S3 Pin   Notes
 *   ─────────────────────────────────────────────────────
 *   VCC          3.3V           Do NOT use 5V — will destroy CC1101
 *   GND          GND
 *   SCK          GPIO 12        SPI clock (FSPI)
 *   MOSI         GPIO 11        SPI data to CC1101 (FSPI)
 *   MISO         GPIO 13        SPI data from CC1101 (FSPI)
 *   CSN          GPIO 10        SPI chip select (active LOW)
 *   GDO0         GPIO 2         Packet-received interrupt
 *   GDO2         (NC)           Not used in this sketch
 *
 * ── Wiring (ESP32-S3 DevKitC-1 → SSD1315 OLED 128×64 I2C) ──────────────────
 *
 *   OLED Pin     ESP32-S3 Pin   Notes
 *   ─────────────────────────────────────────────────────
 *   VCC          3.3V
 *   GND          GND
 *   SDA          GPIO 8         I2C data (Wire default)
 *   SCL          GPIO 9         I2C clock (Wire default)
 *
 *   ⚠ GPIO 19/20 are USB D-/D+ on ESP32-S3 — do not use for SPI.
 *   ⚠ GPIO 22-25 do not exist on ESP32-S3.
 *
 *   ⚠ Add a 100 nF decoupling capacitor between VCC and GND, close to CC1101.
 *   ⚠ Keep SPI traces short to minimise noise at 433 MHz.
 *
 * ─────────────────────────────────────────────────────────────────────────────
 *
 * OLED layout (128×64, font 1 = 6×8 px → 21 chars / 8 rows)
 *
 *   ┌─────────────────────┐
 *   │  CC1101 RECEIVER    │  ← inverted header bar
 *   │ #0042   Len:  6 B   │
 *   │ RSSI: -67.3 dBm     │
 *   │ LQI:  24            │
 *   │ D3 91 04 41 42 43   │  ← hex bytes row 1 (up to 7 bytes)
 *   │ 44 3F 4B …          │  ← hex bytes row 2 (remaining)
 *   └─────────────────────┘
 */

#include <RadioLib.h>
#include <SPI.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ── Pin definitions — CC1101 (SPI) ───────────────────────────────────────────
#define CC1101_SCK   12
#define CC1101_MISO  13
#define CC1101_MOSI  11
#define CC1101_CS    10
#define CC1101_GDO0   2

// ── Pin definitions — OLED (I2C) ─────────────────────────────────────────────
#define OLED_SDA      8
#define OLED_SCL      9
#define OLED_ADDR  0x3C   // try 0x3D if display stays blank
#define OLED_W      128
#define OLED_H       64

Adafruit_SSD1306 display(OLED_W, OLED_H, &Wire, -1);

// ── Signal parameters — Ecowitt WS90 (Fine Offset OOK NRZ) ─────────────────
#define RF_FREQUENCY  433.92   // MHz
// WS90 bit rate: 17.241 kbps (try 34.483 if nothing received — some hw revisions differ)
#define RF_BAUD       34.483   // kbps NRZ data rate
#define RF_BW         250.0    // kHz — wider is more tolerant for OOK; narrow later once receiving
#define RF_POWER      10       // dBm
#define SYNC_WORD_1   0x2D     // Fine Offset sync byte 1
#define SYNC_WORD_2   0xD4     // Fine Offset sync byte 2
#define WS90_PKT_LEN  19       // Expected payload bytes (incl. CRC)
#define MAX_PACKET    64       // CC1101 RX FIFO max

// ── RadioLib: custom FSPI + CC1101 module ────────────────────────────────────
SPIClass spi(FSPI);
// Module(cs, irq/gdo0, rst, gpio/gdo2, spi)
CC1101 radio = new Module(CC1101_CS, CC1101_GDO0, RADIOLIB_NC, RADIOLIB_NC, spi);

// ── ISR flag ─────────────────────────────────────────────────────────────────
volatile bool packetReceived = false;
IRAM_ATTR void onReceive() { packetReceived = true; }

// ── Packet counter ────────────────────────────────────────────────────────────
static uint32_t pktCount = 0;

// ── OLED helpers ─────────────────────────────────────────────────────────────
// Draw the static header bar (inverted) — call once or on full refresh
static void oledHeader() {
    display.fillRect(0, 0, OLED_W, 10, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(20, 1);
    display.print(F("WS90 RECEIVER"));
    display.setTextColor(SSD1306_WHITE);
}

// Fallback display — raw hex bytes (used when WS90 decode fails)
static void oledShowRaw(const uint8_t *buf, int len, float rssi, uint8_t lqi) {
    display.clearDisplay();
    oledHeader();

    display.setCursor(0, 12);
    display.printf("#%-5lu  Len: %2d B", (unsigned long)pktCount, len);

    display.setCursor(0, 22);
    display.printf("RSSI: %.1f dBm", rssi);

    display.setCursor(0, 32);
    display.printf("LQI:  %d", (int)lqi);

    int row = 0;
    display.setCursor(0, 42);
    for (int i = 0; i < len && row < 2; i++) {
        if (i > 0 && (i % 7) == 0) {
            row++;
            display.setCursor(0, 42 + row * 10);
        }
        display.printf("%02X ", buf[i]);
    }

    display.display();
}

// Show a status message (used during init / waiting)
static void oledStatus(const char *line1, const char *line2 = nullptr) {
    display.clearDisplay();
    oledHeader();
    display.setCursor(0, 16);
    display.print(line1);
    if (line2) {
        display.setCursor(0, 28);
        display.print(line2);
    }
    display.display();
}

// ── WS90 protocol decoder ────────────────────────────────────────────────────
// Fine Offset / Ecowitt WS90 packet (19 bytes, Manchester-decoded, after sync):
//
//  [0]      0x90 — model ID
//  [1-2]    Device ID (big-endian)
//  [3]      Battery (%)
//  [4-5]    Temperature: (((b[4]&0x0F)<<8 | b[5]) - 400) / 10  → °C
//  [6]      Humidity (%)
//  [7-8]    Wind direction: ((b[7]&0x01)<<8 | b[8])  → 0-359°
//  [9]      Wind speed × 0.1  → m/s
//  [10]     Wind gust  × 0.1  → m/s
//  [11]     UV index   × 0.1
//  [12-14]  Light: (b[12]<<16 | b[13]<<8 | b[14]) / 10  → lux
//  [15-16]  Haptic rain: (b[15]<<8 | b[16]) × 0.1  → mm
//  [17]     Flags / reserved
//  [18]     CRC-8 (poly=0x31, init=0x00) over bytes 0-17
//
//  ⚠ Based on rtl_433 community docs. Verify indices against your firmware.

struct WS90Data {
    uint16_t id;
    uint8_t  battery;   // %
    float    temp_c;    // °C
    uint8_t  humidity;  // %
    uint16_t wind_dir;  // 0-359 degrees
    float    wind_ms;   // m/s
    float    gust_ms;   // m/s
    float    uv_index;
    float    lux;
    float    rain_mm;
    bool     valid;
};

// CRC-8/MAXIM — polynomial 0x31, init 0x00 (standard Fine Offset checksum)
static uint8_t ws90_crc8(const uint8_t *data, uint8_t len) {
    uint8_t crc = 0x00;
    for (uint8_t i = 0; i < len; i++) {
        crc ^= data[i];
        for (uint8_t b = 0; b < 8; b++)
            crc = (crc & 0x80) ? ((crc << 1) ^ 0x31) : (crc << 1);
    }
    return crc;
}

static WS90Data decodeWS90(const uint8_t *b, int len, bool &crc_ok) {
    WS90Data d = {};
    crc_ok = false;
    if (len < WS90_PKT_LEN || b[0] != 0x90) return d;
    crc_ok = (ws90_crc8(b, WS90_PKT_LEN - 1) == b[WS90_PKT_LEN - 1]);

    d.id       = (uint16_t)b[1] << 8 | b[2];
    d.battery  = b[3];
    d.temp_c   = (((b[4] & 0x0F) << 8 | b[5]) - 400) / 10.0f;
    d.humidity = b[6];
    d.wind_dir = ((uint16_t)(b[7] & 0x01) << 8) | b[8];
    d.wind_ms  = b[9]  * 0.1f;
    d.gust_ms  = b[10] * 0.1f;
    d.uv_index = b[11] * 0.1f;
    d.lux      = ((uint32_t)b[12] << 16 | (uint32_t)b[13] << 8 | b[14]) / 10.0f;
    d.rain_mm  = ((uint16_t)b[15] << 8 | b[16]) * 0.1f;
    d.valid    = true;
    return d;
}

// ── WS90 OLED display ─────────────────────────────────────────────────────────
// 128×64, 6×8 font → 21 chars / row:
//  ┌─────────────────────┐
//  │WS90#XXXX  99%  OK   │  ← inverted: ID + battery + CRC status
//  │T:23.5°C  H:65%      │
//  │Wind:270°  3.2m/s    │
//  │Gust:4.5m/s  -67dBm  │
//  │UV:2.1  L:5420lux    │
//  │Rain:1.2mm  #0042    │
//  └─────────────────────┘
static void oledShowWeather(const WS90Data &d, float rssi, bool crc_ok) {
    char row[22];
    display.clearDisplay();

    // Header (inverted) — device ID + battery + CRC indicator
    display.fillRect(0, 0, OLED_W, 10, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(0, 1);
    snprintf(row, sizeof(row), "WS90#%04X %3d%% %s",
             d.id, d.battery, crc_ok ? "OK" : "!CRC");
    display.print(row);
    display.setTextColor(SSD1306_WHITE);

    // Row 1 — Temperature + Humidity  (0xF8 = ° in CP437)
    display.setCursor(0, 12);
    snprintf(row, sizeof(row), "T:%.1f\xF8" "C  H:%d%%", d.temp_c, d.humidity);
    display.print(row);

    // Row 2 — Wind direction + speed
    display.setCursor(0, 22);
    snprintf(row, sizeof(row), "Wind:%3d\xF8" "  %.1fm/s", d.wind_dir, d.wind_ms);
    display.print(row);

    // Row 3 — Gust + RSSI
    display.setCursor(0, 32);
    snprintf(row, sizeof(row), "Gust:%.1fm/s  %.0fdBm", d.gust_ms, rssi);
    display.print(row);

    // Row 4 — UV index + light
    display.setCursor(0, 42);
    snprintf(row, sizeof(row), "UV:%.1f  L:%.0flux", d.uv_index, d.lux);
    display.print(row);

    // Row 5 — Rain + packet counter
    display.setCursor(0, 52);
    snprintf(row, sizeof(row), "Rain:%.1fmm  #%lu", d.rain_mm, (unsigned long)pktCount);
    display.print(row);

    display.display();
}

// ── Setup ────────────────────────────────────────────────────────────────────
void setup() {
    Serial.begin(115200);
    // Wait up to 3 s for USB CDC host to connect (ESP32-S3 native USB)
    for (uint32_t t = millis(); !Serial && (millis() - t < 3000); ) delay(10);
    Serial.println("\n==============================");
    Serial.println("  ESP32 CC1101 Receiver");
    Serial.println("==============================");

    spi.begin(CC1101_SCK, CC1101_MISO, CC1101_MOSI, CC1101_CS);

    // ── OLED init ────────────────────────────────────────────────────────
    Wire.begin(OLED_SDA, OLED_SCL);
    if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
        Serial.println("[WARN] OLED not found — check SDA/SCL wiring and I2C address");
        // Continue without display — radio will still work
    } else {
        display.setTextSize(1);
        display.setTextColor(SSD1306_WHITE);
        display.cp437(true);   // Use full 256-char CP437 font
        oledStatus("Initialising radio...");
        Serial.println("[OK] OLED ready");
    }

    // ── CC1101 init ───────────────────────────────────────────────────────

    // begin() with RadioLib defaults — validates chip presence via SPI first
    int state = radio.begin();
    if (state != RADIOLIB_ERR_NONE) {
        Serial.printf("[ERROR] CC1101 not found (SPI/wiring issue), code %d\n", state);
        Serial.println("  → Verify MISO/MOSI not swapped");
        Serial.println("  → Verify 3.3V power with decoupling caps");
        while (true) delay(1000);
    }
    Serial.println("[OK] CC1101 detected");

    // Configure each parameter individually so failures are easy to diagnose
    #define RADIO_CHECK(call, name) do { \
        int _s = (call); \
        if (_s != RADIOLIB_ERR_NONE) { \
            Serial.printf("[ERROR] %s failed, code %d\n", name, _s); \
            while (true) delay(1000); \
        } \
    } while (0)

    RADIO_CHECK(radio.setFrequency(RF_FREQUENCY),            "setFrequency");
    RADIO_CHECK(radio.setBitRate(RF_BAUD),                   "setBitRate");
    RADIO_CHECK(radio.setRxBandwidth(RF_BW),                 "setRxBandwidth");
    RADIO_CHECK(radio.setOutputPower(RF_POWER),              "setOutputPower");
    RADIO_CHECK(radio.setOOK(true),                          "setOOK");
    // NRZ encoding — WS90 is plain OOK NRZ, NOT Manchester.
    // Manchester mode in CC1101 corrupts sync-word detection entirely.
    RADIO_CHECK(radio.setSyncWord(SYNC_WORD_1, SYNC_WORD_2), "setSyncWord");
    // Variable length: accept any packet so we can see what actually arrives
    RADIO_CHECK(radio.variablePacketLengthMode(MAX_PACKET),  "varLenMode");

    Serial.println("\n-- Radio Configuration (WS90) ----------");
    Serial.printf("  Frequency:  %.2f MHz\n",    RF_FREQUENCY);
    Serial.printf("  Baud:       %.3f kbps NRZ\n", RF_BAUD);
    Serial.printf("  Modulation: OOK\n");
    Serial.printf("  BW filter:  %.0f kHz\n",    RF_BW);
    Serial.printf("  Sync word:  0x%02X%02X\n",  SYNC_WORD_1, SYNC_WORD_2);
    Serial.println("-----------------------------------------\n");

    radio.setPacketReceivedAction(onReceive);
    RADIO_CHECK(radio.startReceive(), "startReceive");
    Serial.println("[LISTENING] Waiting for WS90 packets...\n");
    oledStatus("Listening...", "WS90 433.92MHz");
}

// ── Main loop ────────────────────────────────────────────────────────────────
void loop() {
    if (!packetReceived) return;
    packetReceived = false;

    int len = radio.getPacketLength();
    if (len <= 0) {
        Serial.println("[WARN] Empty or invalid packet received");
        radio.startReceive();
        return;
    }
    if (len > MAX_PACKET) len = MAX_PACKET;

    uint8_t buf[MAX_PACKET];
    int state = radio.readData(buf, len);
    if (state != RADIOLIB_ERR_NONE) {
        Serial.printf("[WARN] readData failed, code %d\n", state);
        radio.startReceive();
        return;
    }

    pktCount++;

    // ── RSSI & LQI ───────────────────────────────────────────────────
    float rssi = radio.getRSSI();
    uint8_t lqi = radio.getLQI();

    // ── Serial output ───────────────────────────────────────────────────
    Serial.printf("── Packet #%lu (%d bytes) ──────────────────\n", (unsigned long)pktCount, len);
    Serial.print("  Raw hex: ");
    for (int i = 0; i < len; i++) Serial.printf("%02X ", buf[i]);
    Serial.println();
    Serial.printf("  RSSI: %.1f dBm  LQI: %d\n", rssi, lqi);
    Serial.printf("  CRC expected: 0x%02X  computed: 0x%02X\n",
                  len >= WS90_PKT_LEN ? buf[WS90_PKT_LEN - 1] : 0xFF,
                  len >= WS90_PKT_LEN ? ws90_crc8(buf, WS90_PKT_LEN - 1) : 0xFF);

    bool crc_ok = false;
    WS90Data ws = decodeWS90(buf, len, crc_ok);
    if (ws.valid) {
        Serial.printf("  Model:0x%02X  ID:0x%04X  Bat:%d%%  CRC:%s\n",
                      buf[0], ws.id, ws.battery, crc_ok ? "OK" : "FAIL");
        Serial.printf("  Temp:%.1f C  Hum:%d%%\n",                ws.temp_c, ws.humidity);
        Serial.printf("  Wind:%d deg  %.1fm/s  Gust:%.1fm/s\n",   ws.wind_dir, ws.wind_ms, ws.gust_ms);
        Serial.printf("  UV:%.1f   Light:%.0f lux\n",             ws.uv_index, ws.lux);
        Serial.printf("  Rain:%.1f mm\n",                         ws.rain_mm);
        oledShowWeather(ws, rssi, crc_ok);
    } else {
        Serial.printf("  [WARN] Not WS90 (model=0x%02X len=%d, need 0x90/%d)\n",
                      buf[0], len, WS90_PKT_LEN);
        oledShowRaw(buf, len, rssi, lqi);
    }
    Serial.println("");

    radio.startReceive();  // Re-arm receiver for next packet
}
