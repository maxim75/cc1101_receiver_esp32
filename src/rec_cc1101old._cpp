#include <Arduino.h>
#include <ELECHOUSE_CC1101_SRC_DRV.h>

#define CC1101_FREQ     433.92  // MHz
#define GDO0_PIN        2

constexpr uint8_t RX_BUFFER_SIZE = 64;

void printPacket(const byte *data, byte size) {
  Serial.printf("RX (%u bytes): ", size);
  for (byte i = 0; i < size; i++) {
    Serial.printf("%02X ", data[i]);
  }
  Serial.print("| ASCII: ");
  for (byte i = 0; i < size; i++) {
    char c = static_cast<char>(data[i]);
    Serial.print((c >= 32 && c <= 126) ? c : '.');
  }
  Serial.println();
}

bool containsABCD(const byte *data, byte size) {
  if (size < 4) {
    return false;
  }

  for (byte i = 0; i <= static_cast<byte>(size - 4); i++) {
    if (data[i] == 'A' && data[i + 1] == 'B' && data[i + 2] == 'C' && data[i + 3] == 'D') {
      return true;
    }
  }
  return false;
}

void configureReceiver() {
  // Robust packet mode profile: sync + CRC suppress random noise packets.
  ELECHOUSE_cc1101.setMHZ(CC1101_FREQ);
  ELECHOUSE_cc1101.setCCMode(1);        // packet mode
  ELECHOUSE_cc1101.setModulation(2);    // ASK/OOK
  ELECHOUSE_cc1101.setDRate(4.80);      // matches TX setDRate(4.80)
  ELECHOUSE_cc1101.setRxBW(58.0);
  ELECHOUSE_cc1101.setSyncMode(2);      // require sync word — filters noise
  ELECHOUSE_cc1101.setCrc(true);        // TX has setCrc(true)
  ELECHOUSE_cc1101.setPktFormat(0);     // normal FIFO packet mode
  ELECHOUSE_cc1101.setLengthConfig(1);  // variable packet length
  Serial.println("RX profile: ASK/OOK + dRate 4.8k + Sync(2) + CRC + packet varlen");

  ELECHOUSE_cc1101.SetRx();
}

void setup() {
  Serial.begin(115200);
  Serial.println("=== RX_FIRMWARE_V2_SINGLE_PROFILE ===");
  Serial.printf("Build: %s %s\n", __DATE__, __TIME__);
  Serial.println("CC1101 Receiver Starting...");

  ELECHOUSE_cc1101.setSpiPin(12, 13, 11, 10);
  ELECHOUSE_cc1101.setGDO0(GDO0_PIN);

  if (ELECHOUSE_cc1101.getCC1101()) {
    Serial.println("CC1101 connection OK");
  } else {
    Serial.println("CC1101 connection Error — check wiring");
  }

  ELECHOUSE_cc1101.Init();
  configureReceiver();

  pinMode(GDO0_PIN, INPUT);
  Serial.println("Listening for CC1101 packets...");
}

void loop() {
  static uint32_t diagMs = 0;

  if (millis() - diagMs >= 5000) {
    diagMs = millis();
    uint8_t rxBytes = ELECHOUSE_cc1101.SpiReadStatus(CC1101_RXBYTES) & 0x7F;
    Serial.printf("[diag] waiting... RSSI: %d dBm, RXBYTES: %u, GDO0: %d\n",
                  ELECHOUSE_cc1101.getRssi(), rxBytes, digitalRead(GDO0_PIN));
  }

  if (ELECHOUSE_cc1101.CheckRxFifo(2)) {
    if (!ELECHOUSE_cc1101.CheckCRC()) {
      Serial.println("RX packet dropped: CRC fail");
      ELECHOUSE_cc1101.SpiStrobe(0x3A); // SFRX flush
      ELECHOUSE_cc1101.SpiStrobe(0x34); // SRX re-enable
      return;
    }

    byte rxBuffer[RX_BUFFER_SIZE] = {0};
    byte size = ELECHOUSE_cc1101.ReceiveData(rxBuffer);

    if (size == 0 || size > RX_BUFFER_SIZE) {
      return;
    }

    printPacket(rxBuffer, size);

    if (containsABCD(rxBuffer, size)) {
      Serial.println("Matched payload: ABCD");
    }
  }
}

